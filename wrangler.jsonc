{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "chronium-mind",
  "main": "src/index.js",
  "compatibility_date": "2026-08-16",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    {
      "binding": "CONNECTOR_HEALTH",
      "id": "4ed1a352be6943c8b96d10b6f374a589"
    }
  ],
  "vars": {
    // Which src/ai/index.js adapter handles Qualitative Analysis. Swapping
    // providers is this one line, not a code change - see src/ai/provider.js.
    // OpenAI is the provider. The credential is a Worker SECRET, never a var, never in the repository, the extension, the
    // PWA or browser storage. The operator types it into a hidden prompt (nothing is echoed or saved in shell history):
    //   wrangler secret put OPENAI_API_KEY --env staging
    // AI stays off until it is deliberately switched on (AI_ENABLED, with both cost ceilings).
    "AI_PROVIDER": "openai",

    // PRODUCTION SAFETY (docs/STAGE0_SECURITY.md). Every new network-facing feature is OFF unless its switch is exactly
    // "on", and the Worker itself refuses requests to a feature that is off. Turning a feature on is a deliberate,
    // recorded change. Test-only variables (TEST_MODE, DISCOVERY_ALLOW_PRIVATE, ...) must never appear here:
    // scripts/validate-production-config.mjs rejects them and the Worker refuses to run guarded features if they exist.
    "ENVIRONMENT": "production",
    "FEATURE_DISCOVERY_FETCH": "off",
    "FEATURE_DISCOVERY_CAPTURES": "off",
    "FEATURE_VIEW_CAPTURE": "off",
    "FEATURE_ASK_SOURCES": "off",
    // Paid AI is off. It can only be turned on together with BOTH cost ceilings (AI_PER_VISITOR_PER_DAY and
    // AI_DAILY_CEILING, whole numbers); without them the AI routes answer 404 even when this says "on".
    "AI_ENABLED": "off"
  },

  // STAGING: a separate Worker with its own name, its own storage and its own (empty) secrets. It cannot read or
  // write production data and holds no production AI credential. Create its KV namespace first
  //   wrangler kv namespace create CONNECTOR_HEALTH --env staging
  // The namespace "staging-CONNECTOR_HEALTH" was created on 2026-10-26; its id is below. The validator still refuses a
  // placeholder, the production id, or a reused id.
  "env": {
    "staging": {
      "name": "chronium-mind-staging",
      "kv_namespaces": [
        { "binding": "CONNECTOR_HEALTH", "id": "8253207c950845bb8c32622952585e14" }
      ],
      "vars": {
        "AI_PROVIDER": "openai",
        "ENVIRONMENT": "staging",
        "FEATURE_DISCOVERY_FETCH": "off",
        "FEATURE_DISCOVERY_CAPTURES": "off",
        "FEATURE_VIEW_CAPTURE": "off",
        "FEATURE_ASK_SOURCES": "off",
        "AI_ENABLED": "off",
        // The burst limiter fails closed: if its binding is missing or broken, guarded routes refuse requests.
        "RATE_LIMIT_BINDING": "required"
      },
      // Workers Rate Limiting binding (GA 2025-09-19). Windows are 10 or 60 seconds, counted per Cloudflare location and
      // approximately. namespace_id only has to be a unique positive integer within the account. Whether the Workers
      // Free plan accepts the binding is not stated in Cloudflare's documentation: the first staging deploy settles it.
      "ratelimits": [
        { "name": "RL_FETCH", "namespace_id": "7101", "simple": { "limit": 15, "period": 60 } },
        { "name": "RL_VIEWCAPTURE", "namespace_id": "7102", "simple": { "limit": 15, "period": 60 } },
        { "name": "RL_AI", "namespace_id": "7103", "simple": { "limit": 3, "period": 60 } }
      ]
    }
  }
}
