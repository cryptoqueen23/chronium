{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "chronium-mind",
  "main": "src/index.js",
  "compatibility_date": "2026-08-16",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    {
      "binding": "CONNECTOR_HEALTH",
      "id": "4ed1a352be6943c8b96d10b6f374a589"
    }
  ]
}
